# ==================================================
# Données Machine Learning
# Gérées par DVC + DagsHub
# ==================================================

# Les fichiers de données suivis par DVC sont automatiquement
# ajoutés aux .gitignore locaux par la commande `dvc add`.
#
# Les fichiers .dvc et les .gitignore générés par DVC
# doivent rester versionnés avec Git.

# Conserver les fichiers .gitkeep nécessaires
# à la structure vide des répertoires.
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Ignorer les datasets générés par le preprocessing.
# Ils ne doivent pas être versionnés directement avec Git.
data/processed/*

# Réinclure explicitement le .gitkeep après la règle précédente.
!data/processed/.gitkeep


# ==================================================
# Modèles Machine Learning
# Gérés par MLflow / DVC
# ==================================================

# Artefacts temporaires générés en mode TEST
models/trained/test/

# Conserver les fichiers .gitkeep de structure.
!models/trained/.gitkeep
!models/experiments/.gitkeep
!models/preprocessing/.gitkeep

# Ignorer les artefacts générés par le preprocessing :
# - Frequency Encoding
# - valeurs d'imputation
# - OneHotEncoder
# - StandardScaler
# - métadonnées JSON
# - artefacts du mode TEST
models/preprocessing/*

# Réinclure explicitement le .gitkeep.
!models/preprocessing/.gitkeep


